# Bot token from @BotFather (Chat Access Mode ENABLED)
BOT_TOKEN=123456:ABC-DEF

# Your Telegram user id (account that will link the bot)
# Get it from @userinfobot
OWNER_USER_ID=123456789

# AI backend for replies:
#   agent_sdk  -> Claude Agent SDK with your Claude Max subscription (no extra cost)
#   api        -> anthropic SDK with API key (pay-per-use)
CLAUDE_BACKEND=agent_sdk

# ── agent_sdk mode (Claude Max) ────────────────────────────────────────
# Generate the token on your LOCAL Mac/PC (NOT on the deploy target):
#   npm install -g @anthropic-ai/claude-code
#   claude setup-token
# Paste the value starting with sk-ant-oat01-...
CLAUDE_CODE_OAUTH_TOKEN=

# ── api mode ───────────────────────────────────────────────────────────
# Leave EMPTY if using agent_sdk (otherwise the SDK prefers the API key
# over the OAuth token, ending up billing pay-per-use instead of using Max)
ANTHROPIC_API_KEY=

# Claude model for the "api" backend (default: claude-haiku-4-5-20251001 — fast and cheap)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Claude model for the "agent_sdk" backend (Claude Max). Aliases: sonnet | opus | haiku
# (or a full model id). Default: sonnet — best balance for chat replies.
AGENT_SDK_MODEL=sonnet

# Max tokens per reply
CLAUDE_MAX_TOKENS=400

# Language of your control panel and notices: en (default) or it.
# The bot's fixed lines to a customer follow the customer's language.
UI_LANGUAGE=en

# ── Human handoff ──────────────────────────────────────────────────────
# After you step into a chat (reply to a forwarded notice, or type directly
# in the business chat) the bot stays silent there for this many seconds so
# it doesn't talk over you. /resume lifts it early. Default 1800 = 30 min.
HANDOFF_PAUSE_SECONDS=1800

# ── Conversation memory ────────────────────────────────────────────────
# History is persisted to data/history.json so it survives restarts. Chats with
# no activity for this many days are pruned from memory and file. Default 7.
HISTORY_TTL_DAYS=7

# ── Voice messages (local transcription, faster-whisper) ───────────────
# Voice notes are transcribed on-device (CPU) and fed to the AI like text.
# No external API, no per-use cost. The model is downloaded once into
# ./data/whisper-models on first use.
# Set to 0 to ignore voice messages entirely.
WHISPER_ENABLED=1
# Model size: tiny | base | small | medium | large-v3
#   tiny/base = fast, light (good on a NAS); small/medium = more accurate, heavier
WHISPER_MODEL=base
# "" = auto-detect language. Set "it" to force Italian for better accuracy/speed.
WHISPER_LANGUAGE=
# Voice notes longer than this many seconds are NOT transcribed (a long clip
# can hog the CPU for minutes on a NAS): the customer gets an ack and the note
# is handed off to you. 0 = no limit. Default 300 = 5 min.
VOICE_MAX_SECONDS=300
# cpu (default) or cuda if you have a GPU
WHISPER_DEVICE=cpu
# int8 (fast/low-RAM on CPU) | float16 (GPU) | float32
WHISPER_COMPUTE_TYPE=int8

# ── Channel promo (optional) ───────────────────────────────────────────
# The bot attaches a button with your channel's (tracking) invite link to its
# first reply in every chat, under a short invite line. Repeated at most once
# per chat every PROMO_COOLDOWN_DAYS. Leave empty to turn the feature off.
PROMO_CHANNEL_URL=
# Button label
PROMO_BUTTON_TEXT=📢 Our channel
# What the channel is about, so the AI can answer questions on it (optional)
PROMO_CHANNEL_DESCRIPTION=
# Invite line under the reply (English for any language, _IT for Italian chats)
# PROMO_APPEND_TEXT=P.S. feel free to check out our Telegram channel too 👇
# PROMO_APPEND_TEXT_IT=P.S. se ti va, dai un'occhiata anche al nostro canale Telegram 👇
# Text sent with the button by the manual /promo command
# PROMO_MANUAL_TEXT=📢 Here's the link to our Telegram channel, join from here 👇
# PROMO_MANUAL_TEXT_IT=📢 Ti lascio il link al nostro canale Telegram, entra da qui 👇
# Minimum days between two promos to the same chat (anti-spam)
PROMO_COOLDOWN_DAYS=30

TZ=Europe/Rome

# ── Fixed customer replies (optional overrides) ────────────────────────
# Sent when a message is handed to you without an AI reply, and when the AI
# backend fails. English for any language, _IT for Italian chats.
# FORWARD_ACK=Got it, I'm passing your message on right away. You'll hear back soon. 🙏
# FORWARD_ACK_IT=Perfetto, inoltro subito il tuo messaggio. Ti risponderà a breve. 🙏
# AI_FAILURE_ACK=One moment…
# AI_FAILURE_ACK_IT=Un attimo…
